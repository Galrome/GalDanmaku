<UserControl x:Class="GalDanmaku.App.Views.ConnectionPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:views="clr-namespace:GalDanmaku.App.Views">
  <UserControl.Resources><ResourceDictionary Source="../Styles/ConsoleStyles.xaml" /></UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20"><TextBlock Text="游戏与连接" Style="{StaticResource ConsoleTitle}" /><TextBlock Text="加载适配包，绑定游戏窗口，再开始接收原文。" Style="{StaticResource ConsoleCaption}" Margin="0,6,0,0" /></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
      <StackPanel>
        <views:GamePackPanel DataContext="{Binding Pack}" Margin="0,0,0,16" />
        <Border Style="{StaticResource ConsoleCard}" Margin="0,0,0,16"><StackPanel>
          <DockPanel Margin="0,0,0,12"><ui:Button DockPanel.Dock="Right" AutomationProperties.AutomationId="RefreshWindowsButton" Content="刷新列表" Command="{Binding RefreshCommand}" /><TextBlock Text="目标窗口" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
          <ComboBox AutomationProperties.AutomationId="TargetWindowComboBox" AutomationProperties.Name="目标窗口" ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow}" HorizontalContentAlignment="Stretch" MaxDropDownHeight="320">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ui:Button AutomationProperties.AutomationId="BindWindowButton" Content="绑定窗口" Appearance="Primary" Command="{Binding BindCommand}" Margin="0,0,8,0" />
            <ui:Button Grid.Column="1" AutomationProperties.AutomationId="UnbindWindowButton" Content="解除绑定" Command="{Binding UnbindCommand}" />
            <TextBlock Grid.Column="2" Text="{Binding BoundTarget}" Style="{StaticResource ConsoleCaption}" VerticalAlignment="Center" Margin="12,0,0,0" />
          </Grid>
          <TextBlock Text="支持窗口化与无边框模式；游戏在后台或最小化时自动暂停显示。" Style="{StaticResource ConsoleCaption}" Margin="0,10,0,0" />
        </StackPanel></Border>
        <views:TextSourcePanel DataContext="{Binding TextSource}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
