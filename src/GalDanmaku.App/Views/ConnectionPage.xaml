<UserControl x:Class="GalDanmaku.App.Views.ConnectionPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:views="clr-namespace:GalDanmaku.App.Views">
  <UserControl.Resources><ResourceDictionary Source="../Styles/ConsoleStyles.xaml" /></UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20"><TextBlock Text="游戏与连接" Style="{StaticResource ConsoleTitle}" /><TextBlock Text="绑定游戏窗口后自动识别游戏并查找适配包，再开始接收原文。" Style="{StaticResource ConsoleCaption}" Margin="0,6,0,0" /></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
      <StackPanel>

        <Border Style="{StaticResource ConsoleCard}" Margin="0,0,0,16"><StackPanel>
          <DockPanel Margin="0,0,0,12"><ui:Button DockPanel.Dock="Right" AutomationProperties.AutomationId="RefreshWindowsButton" Content="刷新列表" Command="{Binding RefreshCommand}" /><TextBlock Text="目标窗口" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
          <ComboBox AutomationProperties.AutomationId="TargetWindowComboBox" AutomationProperties.Name="目标窗口" ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow}" SelectionChanged="OnWindowSelected" HorizontalContentAlignment="Stretch" MaxDropDownHeight="320">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ui:Button AutomationProperties.AutomationId="BindWindowButton" Content="绑定窗口" Appearance="Primary" Command="{Binding BindCommand}" Margin="0,0,8,0" />
            <ui:Button Grid.Column="1" AutomationProperties.AutomationId="UnbindWindowButton" Content="解除绑定" Command="{Binding UnbindCommand}" />
            <TextBlock Grid.Column="2" Text="{Binding BoundTarget}" Style="{StaticResource ConsoleCaption}" VerticalAlignment="Center" Margin="12,0,0,0" />
          </Grid>
          <TextBlock Text="支持窗口化与无边框模式；游戏失焦时弹幕暂停并保留当前画面，最小化时隐藏。" Style="{StaticResource ConsoleCaption}" Margin="0,10,0,0" />
        </StackPanel></Border>
        <Border Style="{StaticResource ConsoleCard}" Margin="0,0,0,16"><StackPanel>
          <DockPanel Margin="0,0,0,12"><ui:Button DockPanel.Dock="Right" Content="刷新游戏库" Command="{Binding Pack.RefreshLibraryCommand}" AutomationProperties.AutomationId="RefreshLunaLibraryButton" /><TextBlock Text="Luna 游戏库" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
          <TextBlock Text="选择 LunaTranslator 安装目录或 userconfig 目录，也可填写游戏库 JSON 文件路径。" Style="{StaticResource ConsoleCaption}" Margin="0,0,0,8" />
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ui:TextBox Text="{Binding Pack.LunaLibraryDirectory, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="LunaLibraryPathTextBox" AutomationProperties.Name="Luna 游戏库目录或文件" VerticalContentAlignment="Center" />
            <ui:Button Grid.Column="1" Content="选择目录" Click="OnBrowseLunaLibrary" Margin="8,0,0,0" AutomationProperties.AutomationId="BrowseLunaLibraryButton" />
            <ui:Button Grid.Column="2" Content="应用路径" Click="OnApplyLunaLibrary" Margin="8,0,0,0" AutomationProperties.AutomationId="ApplyLunaLibraryButton" />
          </Grid>
          <TextBlock Text="{Binding Pack.LibraryStatus}" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.AutomationId="LunaLibraryStatusText" />
          <TextBlock Text="只读本机配置。应用路径或刷新游戏库不会重新绑定窗口或中断原文接收；下次绑定时使用新快照。" Style="{StaticResource ConsoleCaption}" Margin="0,6,0,0" />
        </StackPanel></Border>

        <Border Style="{StaticResource ConsoleCard}" Margin="0,0,0,16"><StackPanel>
          <TextBlock Text="{Binding Pack.GameIdentity}" FontSize="16" FontWeight="SemiBold" AutomationProperties.AutomationId="RecognizedGameText" />
          <TextBlock Text="{Binding Pack.IdentityDetails}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.AutomationId="GameIdentityDetailsText" />
          <TextBlock Text="游戏库候选记录" Style="{StaticResource ConsoleCaption}" Margin="0,14,0,6" />
          <ComboBox ItemsSource="{Binding Pack.IdentityCandidates}" SelectedItem="{Binding Pack.SelectedLibraryCandidate}" SelectionChanged="OnAssociationSelectionChanged" MaxDropDownHeight="240" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="GameIdentityCandidateComboBox" AutomationProperties.Name="选择游戏库候选记录">
            <ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding SourceGameId, StringFormat='来源记录：{0}'}" Style="{StaticResource ConsoleCaption}" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <DockPanel Margin="0,14,0,6"><ui:Button DockPanel.Dock="Right" Content="刷新适配包" Command="{Binding Pack.RefreshCommand}" /><TextBlock Text="本地 GamePack" Style="{StaticResource ConsoleCaption}" VerticalAlignment="Center" /></DockPanel>
          <ComboBox ItemsSource="{Binding Pack.Packs}" SelectedItem="{Binding Pack.SelectedPack}" SelectionChanged="OnAssociationSelectionChanged" MaxDropDownHeight="280" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="AssociationGamePackComboBox" AutomationProperties.Name="选择本地剧情适配包">
            <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="IsEnabled" Value="{Binding IsSelectable}" /></Style></ComboBox.ItemContainerStyle>
            <ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Detail}" Style="{StaticResource ConsoleCaption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" /></StackPanel></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="VNDB ID 仅用于确认作品。当前 GamePack V1 无作品 ID 字段，首次关联需手动核对游戏版本和剧情节点兼容性；多条记录时请先选择正确记录。" Style="{StaticResource ConsoleCaption}" Margin="0,10,0,0" />
          <CheckBox x:Name="AssociationCompatibilityCheckBox" Margin="0,12,0,10" AutomationProperties.AutomationId="AssociationCompatibilityCheckBox"><TextBlock Text="已确认此剧情包适用于当前游戏版本，剧情节点兼容" TextWrapping="Wrap" /></CheckBox>
          <WrapPanel>
            <ui:Button Content="确认并保存关联" Appearance="Primary" Command="{Binding Pack.ConfirmAssociationCommand}" IsEnabled="{Binding IsChecked, ElementName=AssociationCompatibilityCheckBox}" Margin="0,0,8,8" AutomationProperties.AutomationId="ConfirmGameAssociationButton" />
            <ui:Button Content="加载已确认 GameId 的所选包" Command="{Binding Pack.LoadCommand}" Margin="0,0,0,8" AutomationProperties.AutomationId="LoadConfirmedGamePackButton" />
          </WrapPanel>
          <TextBlock Text="{Binding Pack.Status}" TextWrapping="Wrap" Margin="0,2,0,0" AutomationProperties.AutomationId="GamePackAssociationStatusText" />
          <TextBlock Text="确认关联或加载剧情包后，请重新开始接收原文。没有适配包也可继续使用 Luna 原文接收。" Style="{StaticResource ConsoleCaption}" Margin="0,6,0,0" />
        </StackPanel></Border>

        <views:TextSourcePanel DataContext="{Binding TextSource}" StartReceptionCommand="{Binding DataContext.StartTextReceptionCommand, RelativeSource={RelativeSource AncestorType=views:ConnectionPage}}" />

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
