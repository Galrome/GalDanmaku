<UserControl x:Class="GalDanmaku.App.Views.TextSourcePanel" x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <UserControl.Resources><ResourceDictionary Source="../Styles/ConsoleStyles.xaml" /></UserControl.Resources>
  <Border Style="{StaticResource ConsoleCard}"><StackPanel>
    <TextBlock Text="Luna 原文接收" Style="{StaticResource ConsoleSectionTitle}" />
    <TextBlock Text="LunaTranslator 原文 WebSocket 地址" Style="{StaticResource ConsoleCaption}" Margin="0,0,0,6" />
    <TextBox AutomationProperties.AutomationId="TextEndpointInput" AutomationProperties.Name="原文 WebSocket 地址" Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" MaxLength="2048" />
    <WrapPanel Margin="0,12,0,0"><ui:Button AutomationProperties.AutomationId="StartTextSourceButton" Content="开始接收" Command="{Binding StartReceptionCommand, ElementName=Root}" Appearance="Primary" Margin="0,0,8,0" /><ui:Button AutomationProperties.AutomationId="StopTextSourceButton" Content="停止接收" Command="{Binding StopCommand}" /></WrapPanel>    <Expander Header="高级连接与逐字合并设置" Margin="0,12,0,0">
      <StackPanel Margin="0,10,0,0">
        <UniformGrid Columns="2">
          <StackPanel Margin="0,0,8,12"><TextBlock Text="初始重连（毫秒）" Style="{StaticResource ConsoleCaption}" Margin="0,0,0,6" /><TextBox AutomationProperties.AutomationId="InitialRetryInput" AutomationProperties.Name="初始重连毫秒" Text="{Binding InitialRetry, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" MaxLength="6" /></StackPanel>
          <StackPanel Margin="8,0,0,12"><TextBlock Text="最大重连（毫秒）" Style="{StaticResource ConsoleCaption}" Margin="0,0,0,6" /><TextBox AutomationProperties.AutomationId="MaximumRetryInput" AutomationProperties.Name="最大重连毫秒" Text="{Binding MaximumRetry, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" MaxLength="6" /></StackPanel>
          <StackPanel Margin="0,0,8,0"><TextBlock Text="连接超时（毫秒）" Style="{StaticResource ConsoleCaption}" Margin="0,0,0,6" /><TextBox AutomationProperties.AutomationId="ConnectTimeoutInput" AutomationProperties.Name="连接超时毫秒" Text="{Binding ConnectTimeout, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" MaxLength="6" /></StackPanel>
          <StackPanel Margin="8,0,0,0"><TextBlock Text="逐字合并间隔（毫秒）" Style="{StaticResource ConsoleCaption}" Margin="0,0,0,6" /><TextBox AutomationProperties.AutomationId="MergeGapInput" AutomationProperties.Name="逐字合并间隔毫秒" Text="{Binding MergeGap, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" MaxLength="5" /></StackPanel>
        </UniformGrid>
        <TextBlock Text="{Binding ConfigurationNotice}" Style="{StaticResource ConsoleCaption}" Margin="0,10,0,0" />
      </StackPanel>
    </Expander>
    <TextBlock AutomationProperties.AutomationId="TextConnectionStatus" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0" />
    <TextBlock Text="原文接收独立于窗口前台状态。事件计数与原文详情可在「高级诊断」查看。" Style="{StaticResource ConsoleCaption}" Margin="0,8,0,0" />
  </StackPanel></Border>
</UserControl>
