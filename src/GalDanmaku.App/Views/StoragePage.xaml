<UserControl x:Class="GalDanmaku.App.Views.StoragePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources><ResourceDictionary Source="../Styles/ConsoleStyles.xaml" /></UserControl.Resources>
  <StackPanel>
    <TextBlock Text="本地存储说明" Style="{StaticResource ConsoleTitle}" Margin="0,0,0,20" />
    <Border Style="{StaticResource ConsoleCard}"><StackPanel>
      <TextBlock Text="弹幕只保存在本机" Style="{StaticResource ConsoleSectionTitle}" />
      <TextBlock Text="弹幕和本地点赞按游戏及已确认的剧情节点保存。没有确认节点时不会把弹幕保存到候选剧情；本应用没有账号、云同步或云端弹幕服务。" TextWrapping="Wrap" />
      <TextBlock Text="当前弹幕数据库" Style="{StaticResource ConsoleCaption}" Margin="0,16,0,6" />
      <TextBox Text="{Binding LocalDatabasePath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" />
      <TextBlock Text="备份前先正常退出程序，再复制数据库所在的整个文件夹，包括可能存在的 SQLite 辅助文件。更新应用不会迁移或清空已有弹幕。" Style="{StaticResource ConsoleCaption}" Margin="0,12,0,16" />
      <TextBlock Text="日志与隐私" Style="{StaticResource ConsoleSectionTitle}" />
      <TextBlock Text="运行日志按日期追加保存，可在高级诊断查看、打开目录或导出。详细日志可能含台词与本地路径，分享前请检查内容；默认导出会移除详细字段。开发测试使用独立数据库。" TextWrapping="Wrap" />
    </StackPanel></Border>
  </StackPanel>
</UserControl>
