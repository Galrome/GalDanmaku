<UserControl x:Class="GalDanmaku.App.Views.StoryLocatorPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <UserControl.Resources><ResourceDictionary Source="../Styles/ConsoleStyles.xaml" /></UserControl.Resources>
  <Border Style="{StaticResource ConsoleCard}"><StackPanel>
    <TextBlock Text="剧情节点定位" Style="{StaticResource ConsoleSectionTitle}" />
    <TextBlock AutomationProperties.AutomationId="StoryLocationStatus" Text="{Binding StatusText}" FontWeight="SemiBold" />
    <TextBlock Text="{Binding Reason}" Style="{StaticResource ConsoleCaption}" Margin="0,6,0,12" />
    <TextBlock AutomationProperties.AutomationId="StoryNodeId" Text="{Binding NodeText, StringFormat=固定节点：{0}}" TextWrapping="Wrap" />
    <TextBlock Text="{Binding CandidateText, StringFormat=候选：{0}}" Style="{StaticResource ConsoleCaption}" Margin="0,6,0,0" />
    <TextBlock AutomationProperties.AutomationId="StoryOffset" Text="{Binding OffsetText}" Style="{StaticResource ConsoleCaption}" Margin="0,6,0,0" />
    <TextBlock Text="{Binding HistoryCount, StringFormat=历史上下文：{0} 句}" Style="{StaticResource ConsoleCaption}" Margin="0,6,0,0" />
    <TextBlock AutomationProperties.AutomationId="StoryIndexStatus" Text="{Binding IndexStatus}" Style="{StaticResource ConsoleCaption}" Margin="0,12,0,0" />
    <ui:Button Content="重置定位上下文" Command="{Binding ResetCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
    <TextBlock Text="读档或跳转后可重置上下文；未知或有歧义时弹幕会暂停并解绑节点。" Style="{StaticResource ConsoleCaption}" Margin="0,10,0,0" />
  </StackPanel></Border>
</UserControl>
