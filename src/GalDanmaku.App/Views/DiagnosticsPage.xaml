<UserControl x:Class="GalDanmaku.App.Views.DiagnosticsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:GalDanmaku.App.Views">
  <UserControl.Resources><ResourceDictionary Source="../Styles/ConsoleStyles.xaml" /></UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20"><TextBlock Text="高级诊断" Style="{StaticResource ConsoleTitle}" /><TextBlock Text="检查原文事件与剧情定位；日常使用无需调整这些选项。" Style="{StaticResource ConsoleCaption}" Margin="0,6,0,0" /></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0"><StackPanel>
      <Border Style="{StaticResource ConsoleCard}" DataContext="{Binding TextSource}" Margin="0,0,0,16"><StackPanel>
        <TextBlock Text="文本源事件" Style="{StaticResource ConsoleSectionTitle}" />
        <UniformGrid Columns="4" Margin="0,0,0,12">
          <StackPanel><TextBlock Text="原始文本" Style="{StaticResource ConsoleCaption}" /><TextBlock AutomationProperties.AutomationId="RawTextCount" Text="{Binding RawCount}" FontSize="22" Margin="0,4,0,0" /></StackPanel>
          <StackPanel><TextBlock Text="新对话" Style="{StaticResource ConsoleCaption}" /><TextBlock AutomationProperties.AutomationId="NewDialogueCount" Text="{Binding NewCount}" FontSize="22" Margin="0,4,0,0" /></StackPanel>
          <StackPanel><TextBlock Text="更新" Style="{StaticResource ConsoleCaption}" /><TextBlock AutomationProperties.AutomationId="UpdatedTextCount" Text="{Binding UpdateCount}" FontSize="22" Margin="0,4,0,0" /></StackPanel>
          <StackPanel><TextBlock Text="过滤" Style="{StaticResource ConsoleCaption}" /><TextBlock AutomationProperties.AutomationId="FilteredTextCount" Text="{Binding FilteredCount}" FontSize="22" Margin="0,4,0,0" /></StackPanel>
        </UniformGrid>
        <TextBlock AutomationProperties.AutomationId="LatestTextEvent" Text="{Binding LatestEvent}" Style="{StaticResource ConsoleCaption}" Margin="0,0,0,12" />
        <TextBlock Text="最新接收原文（归一化后）" Style="{StaticResource ConsoleCaption}" Margin="0,0,0,6" />
        <TextBox AutomationProperties.AutomationId="LatestReceivedText" AutomationProperties.Name="最新归一化原文" Text="{Binding LatestText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="160" VerticalScrollBarVisibility="Auto" />
        <TextBlock Text="按相邻文本与时间间隔启发式识别：重复台词可能被过滤，前缀相似的独立台词可能合并。会话内编号不是剧情节点。" Style="{StaticResource ConsoleCaption}" Margin="0,10,0,0" />
      </StackPanel></Border>
      <views:StoryLocatorPanel DataContext="{Binding Story}" />
    </StackPanel></ScrollViewer>
  </Grid>
</UserControl>
