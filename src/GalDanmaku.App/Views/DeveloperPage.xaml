<UserControl x:Class="GalDanmaku.App.Views.DeveloperPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:views="clr-namespace:GalDanmaku.App.Views">
  <UserControl.Resources><ResourceDictionary Source="../Styles/ConsoleStyles.xaml" /></UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16"><TextBlock Text="开发测试" Style="{StaticResource ConsoleTitle}" /><TextBlock Text="测试使用独立原文源、剧情上下文和测试数据库。正常游戏会话继续运行；页面切换不会加载模拟数据。" Style="{StaticResource ConsoleCaption}" Margin="0,6,0,8" />
      <WrapPanel><ui:Button Content="开始独立测试会话" AutomationProperties.AutomationId="BeginTestSessionButton" Command="{Binding BeginTestSessionCommand}" Appearance="Primary" Margin="0,0,8,0" /><ui:Button Content="停止测试会话" Command="{Binding EndTestSessionCommand}" Margin="0,0,8,0" /><ui:Button Content="关闭开发者模式" Command="{Binding DisableDeveloperModeCommand}" /></WrapPanel>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <Expander Header="本地游戏识别配置（开发维护）" Margin="0,0,0,12"><StackPanel Margin="0,8,0,0"><TextBlock Text="仅供维护本地识别映射。显式选择配置后，会停止正常游戏的原文接收并重新识别已绑定窗口；随后请重新开始接收。开启开发者模式本身不会执行这些操作。" Style="{StaticResource ConsoleCaption}" /><TextBlock Text="{Binding Pack.MappingPath}" Style="{StaticResource ConsoleCaption}" Margin="0,8,0,8" /><ui:Button Content="选择私有映射文件…" Click="OnBrowseMapping" HorizontalAlignment="Left" /></StackPanel></Expander>
      <StackPanel DataContext="{Binding TestSession}" IsEnabled="{Binding DataContext.HasTestSession, RelativeSource={RelativeSource AncestorType=views:DeveloperPage}}">
      <Expander Header="模拟游戏包（合成包 A / 合成包 B）" IsExpanded="True" Margin="0,0,0,12"><StackPanel Margin="0,8,0,0">
        <views:GamePackPanel DataContext="{Binding Pack}" />
        <ui:Button Content="指定其他本地测试包…" Click="OnBrowsePack" HorizontalAlignment="Left" Margin="0,8,0,0" />
        <TextBlock Text="普通 Release 不包含合成包。可指定本地测试包，或使用 IncludeDeveloperFixtures=true 构建开发验证版本。" Style="{StaticResource ConsoleCaption}" Margin="0,8,0,0" />
      </StackPanel></Expander>
      <Expander Header="剧情逐句演示（剧情路线 A / 剧情路线 B）" IsExpanded="True" Margin="0,0,0,12"><StackPanel DataContext="{Binding Story}" Margin="0,8,0,0">
        <CheckBox Content="从测试原文源自动定位（取消后使用逐句与手动输入）" IsChecked="{Binding IsLiveMode}" />
        <ComboBox AutomationProperties.AutomationId="StoryDemoScenario" ItemsSource="{Binding Scenarios}" SelectedItem="{Binding SelectedScenario}" DisplayMemberPath="Label" IsEnabled="{Binding CanInput}" Margin="0,8,0,8" />
        <WrapPanel><ui:Button Content="开始逐句演示" Command="{Binding DataContext.TestSession.StartDemoCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Margin="0,0,8,0" /><ui:Button AutomationProperties.AutomationId="NextStoryDemoButton" Content="下一句" Command="{Binding NextDemoCommand}" Margin="0,0,8,0" /><ui:Button Content="重置演示" Command="{Binding ResetCommand}" /></WrapPanel>
        <TextBlock Text="{Binding DemoProgress}" Style="{StaticResource ConsoleCaption}" Margin="0,8,0,0" />
        <TextBox Text="{Binding LatestText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,8,0,0" />
      </StackPanel></Expander>
      <Expander Header="文本源测试" Margin="0,0,0,12"><StackPanel Margin="0,8,0,0">
        <StackPanel DataContext="{Binding TextSource}">
          <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" DisplayMemberPath="Label" IsEnabled="{Binding CanEdit}" />
          <WrapPanel Margin="0,8,0,8"><ui:Button Content="快速文本测试 / 开始接收" Command="{Binding DataContext.TestSession.StartTextReceptionCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Margin="0,0,8,0" /><ui:Button Content="停止接收" Command="{Binding StopCommand}" /></WrapPanel>
          <TextBlock Text="{Binding Status}" Style="{StaticResource ConsoleCaption}" />
          <TextBlock Text="{Binding LatestEvent}" Style="{StaticResource ConsoleCaption}" />
          <TextBlock Text="{Binding RawCount, StringFormat=原始事件：{0}}" /><TextBlock Text="{Binding NewCount, StringFormat=新对话：{0}}" /><TextBlock Text="{Binding UpdateCount, StringFormat=更新：{0}}" /><TextBlock Text="{Binding FilteredCount, StringFormat=过滤：{0}}" />
        </StackPanel>
        <StackPanel DataContext="{Binding Story}" Margin="0,12,0,0"><TextBlock Text="手动输入直接验证节点定位；Mock 快速测试验证逐字合并、重复与过滤。手动输入前请停止测试源并取消自动定位。" Style="{StaticResource ConsoleCaption}" />
          <TextBox AutomationProperties.AutomationId="ManualStoryText" Text="{Binding ManualText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanInput}" TextWrapping="Wrap" MinHeight="64" MaxLength="65536" Margin="0,8,0,8" />
          <WrapPanel><ui:Button Content="作为新对话输入" Command="{Binding NewDialogueCommand}" Margin="0,0,8,0" /><ui:Button Content="更新当前对话" Command="{Binding UpdateDialogueCommand}" /></WrapPanel>
        </StackPanel>
      </StackPanel></Expander>
      <Expander Header="剧情索引测试" Margin="0,0,0,12"><StackPanel Margin="0,8,0,0">
        <ui:Button Content="卸载测试包，切换到独立索引" Click="OnIndependentIndex" HorizontalAlignment="Left" />
        <StackPanel DataContext="{Binding Story}" Margin="0,8,0,0"><TextBlock Text="独立索引仅定位，不会绑定或保存弹幕。" Style="{StaticResource ConsoleCaption}" /><TextBox Text="{Binding IndexPath, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanImport}" Margin="0,8,0,8" /><WrapPanel><ui:Button Content="浏览索引…" Click="OnBrowseIndex" IsEnabled="{Binding CanImport}" Margin="0,0,8,0" /><ui:Button Content="加载独立索引" Command="{Binding LoadCommand}" /></WrapPanel></StackPanel>
        <views:StoryLocatorPanel DataContext="{Binding Story}" Margin="0,8,0,0" />
      </StackPanel></Expander>
      <Expander Header="弹幕测试" Margin="0,0,0,12"><StackPanel Margin="0,8,0,0">
        <TextBlock Text="选择普通测试窗口，仅用于覆盖层显示。测试弹幕保存至独立 developer 数据库，不写入正常弹幕数据库。" Style="{StaticResource ConsoleCaption}" />
        <ComboBox ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow}" DisplayMemberPath="Title" Margin="0,8,0,8" />
        <WrapPanel><ui:Button Content="刷新窗口" Command="{Binding RefreshCommand}" Margin="0,0,8,0" /><ui:Button Content="绑定测试窗口" Command="{Binding BindCommand}" Margin="0,0,8,0" /><ui:Button Content="解除测试绑定" Command="{Binding UnbindCommand}" /></WrapPanel>
        <TextBlock Text="{Binding BoundTarget}" Style="{StaticResource ConsoleCaption}" Margin="0,8,0,8" />
        <TextBox Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" />
        <WrapPanel Margin="0,8,0,8"><ui:Button Content="发送测试弹幕" Command="{Binding SendCommand}" Margin="0,0,8,0" /><ui:Button Content="重播 / 重试" Command="{Binding ReplayCommand}" /><CheckBox Content="聚合重复弹幕" IsChecked="{Binding IsAggregationEnabled}" Margin="12,0,0,0" /></WrapPanel>
        <TextBlock Text="{Binding LocalStatus}" Style="{StaticResource ConsoleCaption}" /><TextBlock Text="{Binding CoordinatorText}" Style="{StaticResource ConsoleCaption}" />
      </StackPanel></Expander>
    </StackPanel></StackPanel></ScrollViewer>
  </Grid>
</UserControl>
