<UserControl x:Class="GalDanmaku.App.Views.GamePackPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <UserControl.Resources><ResourceDictionary Source="../Styles/ConsoleStyles.xaml" /></UserControl.Resources>
  <Border Style="{StaticResource ConsoleCard}"><StackPanel>
    <TextBlock Text="游戏包" Style="{StaticResource ConsoleSectionTitle}" />
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <ComboBox AutomationProperties.AutomationId="GamePackSelector" AutomationProperties.Name="游戏包" ItemsSource="{Binding Packs}" SelectedItem="{Binding SelectedPack}" HorizontalContentAlignment="Stretch" MaxDropDownHeight="320" Margin="0,0,8,0">
        <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"><Setter Property="IsEnabled" Value="{Binding IsSelectable}" /><Setter Property="ToolTip" Value="{Binding Detail}" /><Setter Property="ToolTipService.ShowOnDisabled" Value="True" /></Style></ComboBox.ItemContainerStyle>
        <ComboBox.ItemTemplate><DataTemplate><StackPanel>
          <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Detail}" FontSize="12" MaxWidth="360" TextWrapping="Wrap" Margin="0,4,0,0">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsSelectable}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
        </StackPanel></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <ui:Button Grid.Column="1" AutomationProperties.AutomationId="RefreshGamePacksButton" Content="刷新" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
      <ui:Button Grid.Column="2" AutomationProperties.AutomationId="LoadGamePackButton" Content="加载" Appearance="Primary" Command="{Binding LoadCommand}" />
    </Grid>
    <TextBlock AutomationProperties.AutomationId="GamePackStatus" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,10,0,6" />
    <TextBlock AutomationProperties.AutomationId="ActiveGamePackText" Text="{Binding ActiveSummary, StringFormat=当前游戏包：{0}}" Style="{StaticResource ConsoleCaption}" />
    <TextBlock Text="切换游戏包会停止文本接收，并重置定位与弹幕。" Style="{StaticResource ConsoleCaption}" Margin="0,8,0,0" />
  </StackPanel></Border>
</UserControl>
