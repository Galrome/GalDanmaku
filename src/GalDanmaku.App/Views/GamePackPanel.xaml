<UserControl x:Class="GalDanmaku.App.Views.GamePackPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <Border Padding="18" CornerRadius="10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
    <StackPanel>
      <TextBlock Text="游戏包" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <ComboBox x:Name="GamePackSelector" AutomationProperties.AutomationId="GamePackSelector" AutomationProperties.Name="游戏包"
                  ItemsSource="{Binding Packs}" SelectedItem="{Binding SelectedPack}" HorizontalContentAlignment="Stretch" MinHeight="56" MaxDropDownHeight="320" Margin="0,0,8,0">
          <ComboBox.ItemContainerStyle>
            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
              <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
            </Style>
          </ComboBox.ItemContainerStyle>
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="2,3">
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="480" />
                <TextBlock Text="{Binding Detail}" Margin="0,3,0,0" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="480" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ui:Button x:Name="RefreshGamePacksButton" AutomationProperties.AutomationId="RefreshGamePacksButton" Grid.Column="1" Content="刷新" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
        <ui:Button x:Name="LoadGamePackButton" AutomationProperties.AutomationId="LoadGamePackButton" Grid.Column="2" Content="加载" Appearance="Primary" Command="{Binding LoadCommand}" />
      </Grid>
      <TextBlock x:Name="GamePackStatus" AutomationProperties.AutomationId="GamePackStatus" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,10,0,6" />
      <TextBlock x:Name="ActiveGamePackText" AutomationProperties.AutomationId="ActiveGamePackText" Text="{Binding ActiveSummary, StringFormat=当前游戏包：{0}}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      <TextBlock Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 Text="游戏包只含声明式数据（剧情索引、文本源与清理规则）。同一时间仅一个游戏包生效；切换会停止文本接收并重置定位与弹幕。" />
    </StackPanel>
  </Border>
</UserControl>
