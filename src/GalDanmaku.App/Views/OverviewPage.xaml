<UserControl x:Class="GalDanmaku.App.Views.OverviewPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <UserControl.Resources><ResourceDictionary Source="../Styles/ConsoleStyles.xaml" /></UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,20">
      <ui:Button DockPanel.Dock="Right" AutomationProperties.AutomationId="ShowFloatingComposerButton" Content="显示悬浮条" Command="{Binding ShowFloatingComposerCommand}" Appearance="Primary" VerticalAlignment="Center" />
      <StackPanel><TextBlock Text="概览" Style="{StaticResource ConsoleTitle}" /><TextBlock Text="绑定游戏窗口，连接 Luna，确认剧情节点后即可发送弹幕。" Style="{StaticResource ConsoleCaption}" Margin="0,6,12,0" /></StackPanel>
    </DockPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0"><StackPanel>
      <Border Style="{StaticResource ConsoleCard}" Margin="0,0,0,16"><StackPanel>
        <DockPanel><ui:Button DockPanel.Dock="Right" Content="选择游戏窗口" Click="OnConnectionClick" /><TextBlock Text="当前游戏" Style="{StaticResource ConsoleSectionTitle}" /></DockPanel>
        <TextBlock Text="{Binding Pack.GameIdentity}" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,8" />
        <TextBlock Text="{Binding BoundTarget}" Style="{StaticResource ConsoleCaption}" />
        <TextBlock AutomationProperties.AutomationId="ActivePackLabel" Text="{Binding Pack.Status}" Style="{StaticResource ConsoleCaption}" Margin="0,8,0,0" />
      </StackPanel></Border>
      <Border Style="{StaticResource ConsoleCard}" Margin="0,0,0,16"><StackPanel>
        <TextBlock Text="当前运行状态" Style="{StaticResource ConsoleSectionTitle}" />
        <WrapPanel><TextBlock Text="{Binding WindowBindingText}" Margin="0,0,20,8" /><TextBlock Text="{Binding TextSource.ConnectionText, StringFormat=Luna：{0}}" Margin="0,0,20,8" /><TextBlock Text="{Binding TextSource.ReceptionText}" Margin="0,0,0,8" /></WrapPanel>
        <TextBlock AutomationProperties.AutomationId="CoordinatorStatusText" Text="{Binding CoordinatorText}" TextWrapping="Wrap" />
      </StackPanel></Border>
      <Border Style="{StaticResource ConsoleCard}"><StackPanel>
        <DockPanel Margin="0,0,0,12"><ui:Button DockPanel.Dock="Right" AutomationProperties.AutomationId="ReplayNodeButton" Content="重播 / 重试" Command="{Binding ReplayCommand}" /><TextBlock Text="当前会话" Style="{StaticResource ConsoleSectionTitle}" /></DockPanel>
        <TextBlock Text="当前原文" Style="{StaticResource ConsoleCaption}" Margin="0,0,0,6" />
        <TextBox AutomationProperties.AutomationId="StoryCurrentText" Text="{Binding TextSource.LatestText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="160" VerticalScrollBarVisibility="Auto" FontSize="16" />
        <TextBlock AutomationProperties.AutomationId="BoundNodeLabel" Text="{Binding Story.StatusText, StringFormat=剧情定位：{0}}" Margin="0,12,0,8" />
        <TextBlock Text="{Binding Story.Reason}" Style="{StaticResource ConsoleCaption}" />
        <TextBlock AutomationProperties.AutomationId="SavedCountText" Text="{Binding SavedCount, StringFormat=当前确认节点已保存 {0} 条弹幕}" Style="{StaticResource ConsoleCaption}" Margin="0,8,0,0" />
        <TextBlock AutomationProperties.AutomationId="LocalStatusText" Text="{Binding LocalStatus}" Style="{StaticResource ConsoleCaption}" Margin="0,8,0,0" />
      </StackPanel></Border>
    </StackPanel></ScrollViewer>
  </Grid>
</UserControl>
