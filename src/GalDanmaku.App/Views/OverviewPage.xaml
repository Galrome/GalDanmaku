<UserControl x:Class="GalDanmaku.App.Views.OverviewPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <UserControl.Resources><ResourceDictionary Source="../Styles/ConsoleStyles.xaml" /></UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid Margin="0,0,0,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0"><TextBlock Text="控制台" Style="{StaticResource ConsoleTitle}" /><TextBlock Text="配置完成后，使用游戏旁的悬浮条发送弹幕。" Style="{StaticResource ConsoleCaption}" Margin="0,6,0,0" /></StackPanel>
      <ui:Button Grid.Column="1" AutomationProperties.AutomationId="ShowFloatingComposerButton" Content="显示悬浮条" Command="{Binding ShowFloatingComposerCommand}" Appearance="Primary" VerticalAlignment="Center" />
    </Grid>
    <Border Grid.Row="1" Style="{StaticResource ConsoleCard}" DataContext="{Binding Story}" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="剧情定位与逐句演示" Style="{StaticResource ConsoleSectionTitle}" />
        <CheckBox AutomationProperties.AutomationId="LiveStoryMode" Content="使用实时文本定位" IsChecked="{Binding IsLiveMode}" IsEnabled="{Binding CanLoad}" />
        <TextBlock Text="切换模式会重置上下文；取消实时定位后，可在「高级诊断」手动输入原文。" Style="{StaticResource ConsoleCaption}" Margin="0,8,0,0" />
        <StackPanel>
          <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CanInput}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
          <TextBlock Text="不会自动换句。当前句一直保留，点击「下一句」才推进；可用「重播 / 重试」重新播放当前节点的弹幕。" Style="{StaticResource ConsoleCaption}" Margin="0,8,0,0" />
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ComboBox AutomationProperties.AutomationId="StoryDemoScenario" AutomationProperties.Name="演示场景" ItemsSource="{Binding Scenarios}" SelectedItem="{Binding SelectedScenario}" DisplayMemberPath="Label" IsEnabled="{Binding HasDemoFrames}" Margin="0,0,8,0" />
            <ui:Button Grid.Column="1" AutomationProperties.AutomationId="NextStoryDemoButton" Content="下一句" Command="{Binding NextDemoCommand}" Appearance="Primary" Margin="0,0,8,0" />
            <ui:Button Grid.Column="2" AutomationProperties.AutomationId="ResetStoryContextButton" Content="重置" Command="{Binding ResetCommand}" />
          </Grid>
          <TextBlock Margin="0,8,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource ConsoleCaption}"><Setter Property="Text" Value="{Binding DemoProgress}" /><Style.Triggers><DataTrigger Binding="{Binding HasDemoFrames}" Value="False"><Setter Property="Text" Value="当前索引没有内置演示，可在「高级诊断」手动输入原文。" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </StackPanel>
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
      <StackPanel>
        <UniformGrid Columns="2" Margin="0,0,0,16">
          <Border Style="{StaticResource ConsoleCard}" Margin="0,0,6,0"><StackPanel>
            <TextBlock Text="当前游戏包" Style="{StaticResource ConsoleCaption}" />
            <TextBlock AutomationProperties.AutomationId="ActivePackLabel" Text="{Binding Pack.ActiveSummary}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,12" />
            <ui:Button Content="选择游戏包" Click="OnConnectionClick" HorizontalAlignment="Left" />
          </StackPanel></Border>
          <Border Style="{StaticResource ConsoleCard}" Margin="6,0,0,0"><StackPanel>
            <TextBlock Text="目标窗口" Style="{StaticResource ConsoleCaption}" />
            <TextBlock Text="{Binding BoundTarget}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,12" />
            <ui:Button Content="选择目标窗口" Click="OnConnectionClick" HorizontalAlignment="Left" />
          </StackPanel></Border>
        </UniformGrid>
        <Border Style="{StaticResource ConsoleCard}" Margin="0,0,0,16"><StackPanel>
          <DockPanel Margin="0,0,0,12"><ui:Button DockPanel.Dock="Right" AutomationProperties.AutomationId="ReplayNodeButton" Content="重播 / 重试" Command="{Binding ReplayCommand}" /><TextBlock Text="当前会话" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
          <WrapPanel Margin="0,0,0,12">
            <Border Background="#263440" CornerRadius="5" Padding="8,5" Margin="0,0,8,4"><TextBlock AutomationProperties.AutomationId="BoundNodeLabel" Text="{Binding ComposerNodeText, StringFormat=节点 · {0}}" FontSize="12" Foreground="#BCE8F5" /></Border>
            <TextBlock Text="{Binding TextSource.Status}" Style="{StaticResource ConsoleCaption}" VerticalAlignment="Center" Margin="0,0,0,4" />
          </WrapPanel>
          <TextBlock Text="当前原文" Style="{StaticResource ConsoleCaption}" Margin="0,0,0,6" />
          <TextBox AutomationProperties.AutomationId="StoryCurrentText" AutomationProperties.Name="定位输入原文" Text="{Binding Story.LatestText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="132" VerticalScrollBarVisibility="Auto" FontSize="16" Padding="12,10" />
          <TextBlock AutomationProperties.AutomationId="CoordinatorStatusText" Text="{Binding CoordinatorText}" Style="{StaticResource ConsoleCaption}" Margin="0,10,0,8" />
          <WrapPanel><TextBlock AutomationProperties.AutomationId="NodeTimeText" Text="{Binding NodeTime}" Style="{StaticResource ConsoleCaption}" Margin="0,0,20,4" /><TextBlock AutomationProperties.AutomationId="SavedCountText" Text="{Binding SavedCount, StringFormat=当前节点已保存 {0} 条}" Style="{StaticResource ConsoleCaption}" /></WrapPanel>
          <TextBlock AutomationProperties.AutomationId="LocalStatusText" Text="{Binding LocalStatus}" Style="{StaticResource ConsoleCaption}" Margin="0,8,0,0" />
        </StackPanel></Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
