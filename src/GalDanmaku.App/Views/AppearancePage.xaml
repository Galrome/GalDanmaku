<UserControl x:Class="GalDanmaku.App.Views.AppearancePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources><ResourceDictionary Source="../Styles/ConsoleStyles.xaml" /></UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20"><TextBlock Text="弹幕外观" Style="{StaticResource ConsoleTitle}" /><TextBlock Text="调整新弹幕样式与游戏画面中的播放效果。" Style="{StaticResource ConsoleCaption}" Margin="0,6,0,0" /></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0"><StackPanel>
      <Border Style="{StaticResource ConsoleCard}" Margin="0,0,0,16"><StackPanel>
        <TextBlock Text="新发送弹幕" Style="{StaticResource ConsoleSectionTitle}" />
        <TextBlock Text="颜色应用于新发送的弹幕；字号由系统统一分配，聚合弹幕随数量增大。" Style="{StaticResource ConsoleCaption}" Margin="0,0,0,16" />
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="48" /></Grid.RowDefinitions>
          <TextBlock Text="颜色" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" AutomationProperties.AutomationId="CommentColorComboBox" AutomationProperties.Name="弹幕颜色" ItemsSource="{Binding Colors}" SelectedItem="{Binding SelectedColor}" DisplayMemberPath="Label" IsEnabled="{Binding IsLocalIdle}" Width="160" HorizontalAlignment="Left" VerticalAlignment="Center" />
        </Grid>
      </StackPanel></Border>
      <Border Style="{StaticResource ConsoleCard}"><StackPanel>
        <TextBlock Text="播放显示" Style="{StaticResource ConsoleSectionTitle}" />
        <CheckBox Content="聚合重复弹幕" IsChecked="{Binding IsAggregationEnabled}" AutomationProperties.AutomationId="AggregationCheckBox" Margin="0,0,0,6" />
        <TextBlock Text="切换会重播当前节点" Style="{StaticResource ConsoleCaption}" Margin="0,0,0,10" />
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="*" /><ColumnDefinition Width="88" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="52" /><RowDefinition Height="52" /></Grid.RowDefinitions>
          <TextBlock Text="不透明度" VerticalAlignment="Center" />
          <Slider Grid.Column="1" AutomationProperties.AutomationId="OpacitySlider" AutomationProperties.Name="不透明度" Minimum="10" Maximum="100" Value="{Binding OpacityPercent}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding OpacityPercent, StringFormat={}{0:0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" />
          <TextBlock Grid.Row="1" Text="滚动速度" VerticalAlignment="Center" />
          <Slider Grid.Row="1" Grid.Column="1" AutomationProperties.AutomationId="SpeedSlider" AutomationProperties.Name="滚动速度" Minimum="40" Maximum="400" Value="{Binding Speed}" TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
          <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Speed, StringFormat={}{0:0} DIP/s}" HorizontalAlignment="Right" VerticalAlignment="Center" />
          <TextBlock Grid.Row="2" Text="显示区域" VerticalAlignment="Center" />
          <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" AutomationProperties.AutomationId="DisplayAreaComboBox" AutomationProperties.Name="显示区域" ItemsSource="{Binding Areas}" SelectedItem="{Binding SelectedArea}" DisplayMemberPath="Label" Width="160" HorizontalAlignment="Left" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Text="区域太小时会跳过无法容纳的弹幕；扩大区域后可在概览重播。" Style="{StaticResource ConsoleCaption}" Margin="0,12,0,0" />
      </StackPanel></Border>
    </StackPanel></ScrollViewer>
  </Grid>
</UserControl>
