<ui:FluentWindow x:Class="GalDanmaku.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:GalDanmaku.App.Views"
                 Title="GalDanmaku"
                 Width="800" Height="900" MinWidth="640" MinHeight="620"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource ApplicationBackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ui:TitleBar Title="GalDanmaku" ShowMaximize="True" />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="28,16,28,24">
        <TextBlock Text="让故事多一层共鸣" FontSize="26" FontWeight="SemiBold" />
        <TextBlock Text="接收游戏原文；在独立的模拟剧情节点保存与重播本地弹幕。" Margin="0,6,0,22" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <views:TextSourcePanel DataContext="{Binding TextSource}" Margin="0,0,0,20" />

        <Border Padding="18" CornerRadius="10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <ui:Button x:Name="RefreshWindowsButton" AutomationProperties.AutomationId="RefreshWindowsButton" DockPanel.Dock="Right" Content="刷新列表" Command="{Binding RefreshCommand}" />
              <TextBlock Text="目标窗口" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <ComboBox x:Name="TargetWindowComboBox" AutomationProperties.AutomationId="TargetWindowComboBox" AutomationProperties.Name="目标窗口"
                      ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow}" HorizontalContentAlignment="Stretch" MinHeight="62" MaxDropDownHeight="320">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="2,3">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="590" />
                    <TextBlock Text="{Binding Details}" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <ui:Button x:Name="BindWindowButton" AutomationProperties.AutomationId="BindWindowButton" Content="绑定窗口" Appearance="Primary" Command="{Binding BindCommand}" Margin="0,0,10,0" />
              <ui:Button x:Name="UnbindWindowButton" AutomationProperties.AutomationId="UnbindWindowButton" Content="解除绑定" Command="{Binding UnbindCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Padding="18,14" Margin="0,12,0,20" CornerRadius="10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
          <StackPanel>
            <TextBlock Text="{Binding BoundTarget}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="BindingStatusText" AutomationProperties.AutomationId="BindingStatusText" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </Border>

        <Border Padding="18" Margin="0,0,0,20" CornerRadius="10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="本地弹幕 · 模拟游戏" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="NodeComboBox" AutomationProperties.AutomationId="NodeComboBox" AutomationProperties.Name="模拟节点"
                        ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode}" DisplayMemberPath="Label"
                        IsEnabled="{Binding IsLocalIdle}" MinWidth="180" HorizontalAlignment="Left" />
              <ui:Button x:Name="ReplayNodeButton" AutomationProperties.AutomationId="ReplayNodeButton" Grid.Column="1"
                         Content="重播 / 重新加载" Command="{Binding ReplayCommand}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
              <TextBlock x:Name="SavedCountText" AutomationProperties.AutomationId="SavedCountText" Text="{Binding SavedCount, StringFormat=已保存 {0} 条}" Margin="0,0,18,0" />
              <TextBlock x:Name="NodeTimeText" AutomationProperties.AutomationId="NodeTimeText" Text="{Binding NodeTime}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <TextBox x:Name="CommentInput" AutomationProperties.AutomationId="CommentInput" AutomationProperties.Name="弹幕内容"
                     Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" IsEnabled="{Binding IsLocalIdle}"
                     MinHeight="40" VerticalContentAlignment="Center" />
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="CommentColorComboBox" AutomationProperties.AutomationId="CommentColorComboBox" AutomationProperties.Name="弹幕颜色"
                        ItemsSource="{Binding Colors}" SelectedItem="{Binding SelectedColor}" DisplayMemberPath="Label" Width="110" IsEnabled="{Binding IsLocalIdle}" />
              <TextBlock Grid.Column="1" Text="最多 500 字 · 自动保存到本机" Margin="12,0,8,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <ui:Button x:Name="SendCommentButton" AutomationProperties.AutomationId="SendCommentButton" Grid.Column="2"
                         Content="发送弹幕" Appearance="Primary" Command="{Binding SendCommand}" />
            </Grid>
            <TextBlock x:Name="LocalStatusText" AutomationProperties.AutomationId="LocalStatusText" Text="{Binding LocalStatus}"
                       Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </Border>

        <TextBlock Text="弹幕外观" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock Text="字号与颜色应用于新发送的弹幕；已保存弹幕保留原样式。" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="105" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="100" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="44" />
            <RowDefinition Height="44" />
            <RowDefinition Height="50" />
          </Grid.RowDefinitions>
          <TextBlock Text="字号" VerticalAlignment="Center" />
          <Slider x:Name="FontSizeSlider" AutomationProperties.AutomationId="FontSizeSlider" AutomationProperties.Name="字号" Grid.Column="1" Minimum="12" Maximum="64" Value="{Binding FontSize}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding FontSize, StringFormat={}{0:0} DIP}" HorizontalAlignment="Right" VerticalAlignment="Center" />
          <TextBlock Grid.Row="1" Text="不透明度" VerticalAlignment="Center" />
          <Slider x:Name="OpacitySlider" AutomationProperties.AutomationId="OpacitySlider" AutomationProperties.Name="不透明度" Grid.Row="1" Grid.Column="1" Minimum="10" Maximum="100" Value="{Binding OpacityPercent}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
          <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding OpacityPercent, StringFormat={}{0:0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" />
          <TextBlock Grid.Row="2" Text="滚动速度" VerticalAlignment="Center" />
          <Slider x:Name="SpeedSlider" AutomationProperties.AutomationId="SpeedSlider" AutomationProperties.Name="滚动速度" Grid.Row="2" Grid.Column="1" Minimum="40" Maximum="400" Value="{Binding Speed}" TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
          <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Speed, StringFormat={}{0:0} DIP/s}" HorizontalAlignment="Right" VerticalAlignment="Center" />
          <TextBlock Grid.Row="3" Text="显示区域" VerticalAlignment="Center" />
          <ComboBox x:Name="DisplayAreaComboBox" AutomationProperties.AutomationId="DisplayAreaComboBox" AutomationProperties.Name="显示区域" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                    ItemsSource="{Binding Areas}" SelectedItem="{Binding SelectedArea}" DisplayMemberPath="Label" HorizontalAlignment="Left" Width="180" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Margin="0,18,0,0" Text="仅在目标处于前台时显示 · 最小化时自动隐藏 · 支持窗口化与无边框模式" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        <TextBlock Margin="0,6,0,0" Text="区域太小时会跳过无法容纳的弹幕；扩大区域后可重播。" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</ui:FluentWindow>
