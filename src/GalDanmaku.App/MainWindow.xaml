<ui:FluentWindow x:Class="GalDanmaku.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="GalDanmaku" Width="1080" Height="720" MinWidth="640" MinHeight="540"
                 FontSize="14" WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True"
                 Background="#13181F" SizeChanged="OnWindowSizeChanged">
  <ui:FluentWindow.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Styles/ConsoleStyles.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary>
  </ui:FluentWindow.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <ui:TitleBar Title="GalDanmaku" ShowMaximize="True" />
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="176" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Background="#171D25" BorderBrush="#2B3440" BorderThickness="0,1,1,0">
        <Grid Margin="10,16,10,12">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel>
            <RadioButton x:Name="OverviewNavigation" AutomationProperties.AutomationId="OverviewNavigation" AutomationProperties.Name="概览" GroupName="ConsoleNavigation" Style="{StaticResource ConsoleNavigation}" Tag="Overview" Checked="OnNavigationChecked" ToolTip="概览" IsChecked="True">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource NavigationIcon}" /><TextBlock x:Name="OverviewLabel" Text="概览" VerticalAlignment="Center" /></StackPanel>
            </RadioButton>
            <RadioButton x:Name="ConnectionNavigation" AutomationProperties.AutomationId="ConnectionNavigation" AutomationProperties.Name="游戏与连接" GroupName="ConsoleNavigation" Style="{StaticResource ConsoleNavigation}" Tag="Connection" Checked="OnNavigationChecked" ToolTip="游戏与连接">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" Style="{StaticResource NavigationIcon}" /><TextBlock x:Name="ConnectionLabel" Text="游戏与连接" VerticalAlignment="Center" /></StackPanel>
            </RadioButton>
            <RadioButton x:Name="AppearanceNavigation" AutomationProperties.AutomationId="AppearanceNavigation" AutomationProperties.Name="弹幕外观" GroupName="ConsoleNavigation" Style="{StaticResource ConsoleNavigation}" Tag="Appearance" Checked="OnNavigationChecked" ToolTip="弹幕外观">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE790;" Style="{StaticResource NavigationIcon}" /><TextBlock x:Name="AppearanceLabel" Text="弹幕外观" VerticalAlignment="Center" /></StackPanel>
            </RadioButton>
          </StackPanel>
          <StackPanel Grid.Row="2">
            <Border Height="1" Background="#2B3440" Margin="4,0,4,12" />
            <RadioButton x:Name="DeveloperNavigation" AutomationProperties.AutomationId="DeveloperNavigation" AutomationProperties.Name="开发测试" GroupName="ConsoleNavigation" Tag="Developer" Checked="OnNavigationChecked" ToolTip="开发测试">
              <RadioButton.Style><Style TargetType="RadioButton" BasedOn="{StaticResource ConsoleNavigation}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsDeveloperMode}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></RadioButton.Style>
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE943;" Style="{StaticResource NavigationIcon}" /><TextBlock x:Name="DeveloperLabel" Text="开发测试" VerticalAlignment="Center" /></StackPanel>
            </RadioButton>
            <RadioButton x:Name="DiagnosticsNavigation" AutomationProperties.AutomationId="DiagnosticsNavigation" AutomationProperties.Name="高级诊断" GroupName="ConsoleNavigation" Style="{StaticResource ConsoleNavigation}" Tag="Diagnostics" Checked="OnNavigationChecked" ToolTip="高级诊断">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource NavigationIcon}" /><TextBlock x:Name="DiagnosticsLabel" Text="高级诊断" VerticalAlignment="Center" /></StackPanel>
            </RadioButton>
            <RadioButton x:Name="StorageNavigation" AutomationProperties.AutomationId="StorageNavigation" AutomationProperties.Name="本地存储说明" GroupName="ConsoleNavigation" Style="{StaticResource ConsoleNavigation}" Tag="Storage" Checked="OnNavigationChecked" ToolTip="本地存储说明">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource NavigationIcon}" /><TextBlock x:Name="StorageLabel" Text="本地存储说明" VerticalAlignment="Center" /></StackPanel>
            </RadioButton>
            <TextBlock x:Name="StorageCaption" Text="弹幕仅保存在本机" Style="{StaticResource ConsoleCaption}" Margin="12,12,0,4" />
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="1" Margin="24,20,24,16">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        <Border Grid.Row="1" Background="#1C2630" CornerRadius="8" BorderBrush="#303D4A" BorderThickness="1" Padding="12,10" Margin="0,12,0,0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="#85CDE7" Margin="0,3,10,0" />
            <TextBlock Grid.Column="1" AutomationProperties.AutomationId="BindingStatusText" Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" Foreground="#BAC5D1" />
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</ui:FluentWindow>
